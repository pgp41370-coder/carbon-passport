# Vercel CLI link data
.vercel

# ---------------------------------------------------------------------------
# Uploaded / private documents — never commit real MSME data.
# Common document formats are ignored everywhere. Only intentionally synthetic
# sample files under the allow-listed folders below may be committed.
# ---------------------------------------------------------------------------
uploads/
private/
real-data/
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.webp
*.heic
*.csv
*.xls
*.xlsx
*.xlsm
*.ods
*.doc
*.docx

# Allow-list: synthetic sample data and app assets only
!public/samples/**
!src/data/**
!src/assets/**
!public/*.png

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
